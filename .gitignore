# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Packaging / build ----
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# ---- Native-installer / local-CI build byproducts (pyside6-deploy + Nuitka) ----
# The local-CI runner (external, outside the repo) and the pyside6-deploy build
# leg may emit these into the repo working tree; they must never be committed.
/dist/
/build/
*.dist/
*.build/
*.onefile-build/
deployment.qmake
.nuitka/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Test / coverage / type-check caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
*.coverage
coverage.xml
htmlcov/
.tox/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- PixelArt Creator scratch / runtime ----
*.pixproj
.claude/hooks/.cbstate-*.json
.claude/hooks/.gleanerstate-*.json
.claude/hooks/.subagent-report-state-*.json
.claude/hooks/.*-debug.log

# ---- Runtime temporal files under docs/ ----
docs/gather-*
docs/checkpoint-*
docs/subagent-report-*

# ---- Stray orchestration artifacts written to repo root ----
subagent-report-*.md
claude-checkpoint-*.md

# ---- PRIVATE build/design artifacts (S19) — gitignored AND purged from git
#      history. These files are intentionally absent from the repository:
#      the design dossier/manifest/inventory/delivery, the 5 mandatory docs,
#      and DEPLOYMENT.md are internal-only. They remain on disk locally. ----
docs/
DEPLOYMENT.md
