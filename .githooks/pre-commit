#!/bin/sh
# pre-commit — product repository gate (generated by container_repo.py;
# re-generate with `container_repo.py install-hooks`, never hand-edit).
#
# Enforces at every commit, before it exists:
#   1. branch names:   main | feat-* | fix-*   (check_branch_naming.py)
#   2. portable names: no OS-reserved/unportable path staged (check_names.py)
#   3. line endings:   no staged file whose ONLY change is CRLF<->LF
#
# And then performs the scan duty: this repository's own memory store is
# refreshed and STAGED, so the map ships inside the commit that changed the
# tree it describes (`memory-graph.md` §6.1).
#
# INSTALLATION: git config core.hooksPath .githooks   (local config — a
# fresh clone must re-run `container_repo.py install-hooks`).
# BYPASS: `git commit --no-verify` skips this, deliberately and visibly.
set -e
HOOK=pre-commit

repo_root=$(git rev-parse --show-toplevel)

# Locate the container: nearest ancestor holding scripts/check_branch_naming.py
# (1 level up for a single-product branch folder, 3 for a multi-product one).
container=$(dirname "$repo_root")
container_found=
for _ in 1 2 3 4; do
    if [ -f "$container/scripts/check_branch_naming.py" ]; then
        container_found=yes
        break
    fi
    container=$(dirname "$container")
done
if [ -z "$container_found" ]; then
    echo "pre-commit: container scripts/ not found above $repo_root; refusing to pass an unrunnable gate." >&2
    exit 1
fi

# Locate a Python. If none is found the hook FAILS rather than passing
# silently — an unrunnable check must never look like a passing one.
if command -v py >/dev/null 2>&1; then
    PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "pre-commit: no Python found; refusing to pass an unrunnable gate." >&2
    exit 1
fi

$PY "$container/scripts"/check_branch_naming.py --project "$container" || {
    echo "pre-commit: branch naming check FAILED - commit refused." >&2
    echo "pre-commit: branches must be 'main', 'feat-<x>' or 'fix-<x>'." >&2
    exit 1
}

$PY "$container/scripts"/check_names.py --staged --repo "$repo_root" || {
    echo "pre-commit: portable-name check FAILED - commit refused." >&2
    echo "pre-commit: no OS-reserved or unportable file name may be committed." >&2
    exit 1
}

# Line endings: a staged file identical to HEAD once CRLF is normalised to LF
# changed NOTHING BUT its line endings. That is a tool rewriting a file on its
# way past, never an edit anyone meant: the diff becomes the whole file, the
# real change stops being reviewable, and this container pins `* -text`
# precisely because copy fidelity is compared BYTE for byte. Inline rather
# than a carried script: it is the generated gate that has to hold, and a
# container overrides the machine-wide guard with its own core.hooksPath.
$PY - "$repo_root" <<'PRECOMMIT_EOL_GUARD' || {
import subprocess, sys


def g(*a):
    d = subprocess.run(["git", "-C", sys.argv[1]] + list(a),
                       capture_output=True)
    return d.stdout if d.returncode == 0 else None


if g("rev-parse", "--verify", "HEAD") is None:
    sys.exit(0)
bad = []
for raw in (g("diff", "--cached", "--name-only", "--diff-filter=M", "-z")
            or b"").split(b"\0"):
    if not raw:
        continue
    path = raw.decode("utf-8", "surrogateescape")
    staged, head = g("show", ":" + path), g("show", "HEAD:" + path)
    if staged is None or head is None or staged == head:
        continue
    if staged.replace(b"\r\n", b"\n") == head.replace(b"\r\n", b"\n"):
        bad.append(path)
for path in bad:
    print("pre-commit:   " + path)
sys.exit(1 if bad else 0)
PRECOMMIT_EOL_GUARD
    echo "pre-commit: line-ending check FAILED - commit refused." >&2
    echo "pre-commit: the file(s) above changed ONLY their line endings," >&2
    echo "pre-commit: which rewrites the whole file and hides the real diff." >&2
    echo "pre-commit: A script reading with read_text() and writing with" >&2
    echo "pre-commit: write_text() does this on Windows - use BINARY mode." >&2
    echo "pre-commit: If the conversion IS the change, use --no-verify." >&2
    exit 1
}

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
case "$branch" in
  main|master)
    # The creation commit is the exception: there is no HEAD yet, and a
    # repository has to start somewhere. A merge is the other one — that
    # is how an accepted branch is meant to arrive.
    if git rev-parse --verify HEAD >/dev/null 2>&1 &&
       [ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
      staged=$(git diff --cached --name-only)
      # The arrangement is not development. A commit whose EVERY staged path
      # is orchestration furniture — the gate, the merge-driver request, the
      # store — is bookkeeping, and it has to remain POSSIBLE: those files are
      # untracked in any product whose gate was installed after its creation
      # commit, and while they stay untracked the first branch commits them
      # and the merge back into main aborts on "untracked working tree files
      # would be overwritten". main could then never receive a pull request.
      # `post-merge` also commits the refreshed map after every merge, and a
      # merge that a hook then fails is worse than a map committed by hand.
      #
      # But POSSIBLE is not OPEN. Until 2026-08-15 the shape of the staged set
      # was the whole test, so anyone — an agent included — could put six
      # commits on main just by staging only `memory/`, and did. The staged set
      # says what a commit touches; it cannot say who decided to make it, and
      # that second question is the one this branch exists to answer. main
      # takes the creation commit and merges; everything else arrives through
      # a pull request.
      #
      # So bookkeeping is now admitted only when the caller SAYS it is
      # bookkeeping, by setting PIXELART_MAIN_BOOKKEEPING=1. `post-merge` sets
      # it around its own commit, which is the automated path. A human doing
      # memory maintenance sets it deliberately and visibly on the command
      # line — the same bargain `--no-verify` offers, and for the same reason:
      # the gate cannot stop someone who means it, only someone who did not
      # notice they were on main. All-or-nothing still applies: one product
      # path in the same commit and it is development again, marker or not.
      if [ -n "$staged" ] && ! printf '%s\n' "$staged" | grep -qvE '^(\.githooks|\.gitattributes|memory)(/|$)'; then
        if [ "${PIXELART_MAIN_BOOKKEEPING:-}" = "1" ]; then
          echo "pre-commit: bookkeeping-only commit on '$branch' (the gate, the" >&2
          echo "pre-commit: merge-driver request, the memory map), declared by" >&2
          echo "pre-commit: PIXELART_MAIN_BOOKKEEPING=1 — allowed: this is the" >&2
          echo "pre-commit: arrangement, not development." >&2
        else
          echo "pre-commit: bookkeeping-only commit on '$branch' is REFUSED:" >&2
          echo "pre-commit: the staged set is orchestration furniture, but" >&2
          echo "pre-commit: nothing declared this as bookkeeping." >&2
          echo "pre-commit:" >&2
          echo "pre-commit: '$branch' takes the creation commit and merges." >&2
          echo "pre-commit: Everything else reaches it through a pull request." >&2
          echo "pre-commit:" >&2
          echo "pre-commit: If this really is store maintenance — a compaction," >&2
          echo "pre-commit: a map refresh — say so, deliberately and visibly:" >&2
          echo "pre-commit:   PIXELART_MAIN_BOOKKEEPING=1 git commit ..." >&2
          echo "pre-commit: post-merge sets it for its own refresh commit, so" >&2
          echo "pre-commit: merges are unaffected." >&2
          exit 1
        fi
      else
        echo "pre-commit: development on '$branch' is refused: '$branch' takes" >&2
        echo "pre-commit: the repository's creation commit and merges, nothing" >&2
        echo "pre-commit: else. Nothing is created for you; take this path:" >&2
        echo "pre-commit:" >&2
        # ONE route, both natures (project-structure.md §8.2a): a product
        # root is `<...>/main` in a single-product container and in a
        # multi-product one alike, and its branches are its own sibling
        # folders. The second arm is not another topology — it is a
        # repository that is not in the branch-folder layout yet, where a
        # sibling worktree would land among ITS siblings and mean something
        # else entirely.
        if [ "$(basename "$repo_root")" = "main" ]; then
            echo "pre-commit:   1. create the branch and its folder beside main/:" >&2
            echo "pre-commit:      py $container/scripts/container_repo.py start-branch \"$repo_root\" --name feat-<slug>" >&2
            echo "pre-commit:   2. switch to it: continue in the folder it prints." >&2
            echo "pre-commit:" >&2
            echo "pre-commit: This container keeps every branch in its own folder," >&2
            echo "pre-commit: so moving there IS the switch. Add --carry to take" >&2
            echo "pre-commit: work already in main/ with you." >&2
        else
            echo "pre-commit:   1. create the branch and switch to it:" >&2
            echo "pre-commit:      git switch -c feat-<slug>     # or fix-<slug>" >&2
            echo "pre-commit:   2. commit there." >&2
            echo "pre-commit:" >&2
            echo "pre-commit: Uncommitted work follows the switch; nothing is lost." >&2
            echo "pre-commit: NOTE: this repository is not in the branch-folder" >&2
            echo "pre-commit: layout — its product root should be <...>/main" >&2
            echo "pre-commit: (project-structure.md invariant 11a). Until it is," >&2
            echo "pre-commit: branches live in place, as above." >&2
        fi
        echo "pre-commit:" >&2
        echo "pre-commit: Merges and the creation commit are allowed; --no-verify" >&2
        echo "pre-commit: bypasses this deliberately and visibly." >&2
        exit 1
      fi
    fi
    ;;
esac

scripts="$container/scripts"

# --- refresh this repository's own memory store, and stage what THIS run
#     made dirty ---------------------------------------------------------
# The map is a TRACKED file that a hook regenerates, so it must travel inside
# the commit that changed the tree it describes. Left dirty in the working
# tree instead, it stops the next merge dead -- "your local changes to
# memory/graph/nodes.jsonl would be overwritten by merge" -- which on a
# product's main is the only way work ever arrives.
#
# BOTH HALVES ARE SCOPED, and each because the unscoped form did damage in a
# delivered system (ported upstream from WebFactory, debt #28, 2026-08-10):
#
#   * WHOLESALE staging. `git add -- "$repo_root/memory"` staged every path
#     in the store, whoever had put it there. A container running concurrent
#     agents therefore committed another agent's in-flight store file under
#     somebody else's message. Pathspec scoping cannot save you: for a
#     pathspec commit git builds a temporary index and this hook's `git add`
#     writes into that same index, so the hook's opinion arrives after the
#     author's.
#   * UNCONDITIONAL rescan. The scan SKIPS the store's own directory by rule
#     (`memory_graph.py walk_tracked`), so a commit whose every staged path is
#     inside the store cannot move the map. Rescanning anyway rewrites rows
#     nobody asked about and sweeps them into one bookkeeping commit.
#
# So: refresh only when this commit contains something the scan can SEE, and
# stage only the paths this run made dirty -- clean before it ran, dirty
# after. A path a concurrent agent had already staged is in neither set; one
# it had edited and not staged is in BOTH, and is left alone for the same
# reason. Either way this hook adds only its own work.
store_dirty() {
    git -C "$repo_root" diff --name-only -- memory 2>/dev/null
    git -C "$repo_root" ls-files --others --exclude-standard -- memory 2>/dev/null
}

# An unborn HEAD -- the repository's creation commit -- has nothing to diff
# against, so there the index itself is the answer; reading it as "no staged
# paths" would skip the very first scan.
if git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    staged=$(git -C "$repo_root" diff --cached --name-only) || staged=""
else
    staged=$(git -C "$repo_root" ls-files --cached) || staged=""
fi
scan_needed=no
if [ -n "$staged" ] && printf '%s\n' "$staged" | grep -qv '^memory/'; then
    scan_needed=yes
fi

if [ ! -f "$repo_root/memory/store-role.json" ]; then
    if [ -d "$repo_root/memory" ]; then
        echo "$HOOK: $repo_root/memory has no store-role.json, so the store was NOT refreshed" >&2
        echo "$HOOK:   memory_graph.py init --store $repo_root/memory --role container" >&2
    fi
elif [ "$scan_needed" = no ]; then
    :   # nothing staged that the scan looks at; the map cannot have moved
elif [ ! -f "$scripts/memory_graph.py" ]; then
    echo "$HOOK: $scripts/memory_graph.py is missing; the store was not refreshed." >&2
else
    memory_dirty_before=$(store_dirty) || memory_dirty_before=""
    $PY "$scripts/memory_graph.py" refresh --store "$repo_root/memory" \
        --root "$repo_root" >/dev/null 2>&1 || {
        echo "$HOOK: memory refresh reported a problem. Run it by hand:" >&2
        echo "$HOOK:   memory_graph.py refresh --store $repo_root/memory" >&2
    }
    store_dirty | while IFS= read -r changed_path; do
        [ -n "$changed_path" ] || continue
        if printf '%s\n' "$memory_dirty_before" | grep -qxF -- "$changed_path"; then
            continue        # somebody else's in-flight edit, not this refresh
        fi
        git -C "$repo_root" add -- "$changed_path" >/dev/null 2>&1 || true
    done
fi
