#!/bin/sh
# scripts-dir: scripts
# pre-commit — product repository gate (generated by container_repo.py;
# re-generate with `container_repo.py install-hooks`, never hand-edit).
#
# Enforces at every commit, before it exists:
#   1. branch names:   main | feat-* | fix-*   (check_branch_naming.py)
#   2. portable names: no OS-reserved/unportable path staged (check_names.py)
#   3. line endings:   no staged file whose endings were REWRITTEN -
#                      endings-only, or a flip that buries a real
#                      edit under lines nobody touched
#
# And then performs the scan duty: this repository's own memory store is
# refreshed and STAGED, so the map ships inside the commit that changed the
# tree it describes (`memory-graph-operations.md` §6.1).
#
# INSTALLATION: git config core.hooksPath .githooks   (local config — a
# fresh clone must re-run `container_repo.py install-hooks`).
# BYPASS: `git commit --no-verify` skips this, deliberately and visibly.
set -e
HOOK=pre-commit

repo_root=$(git rev-parse --show-toplevel)

# Locate the container: nearest ancestor holding <dir>/check_branch_naming.py
# (1 level up for a single-product branch folder, 3 for a multi-product one).
# The directory this hook was installed for is tried first, then `scripts/`.
container=$(dirname "$repo_root")
container_found=
container_scripts=
for _ in 1 2 3 4; do
    for candidate in "scripts"; do
        if [ -f "$container/$candidate/check_branch_naming.py" ]; then
            container_found=yes
            container_scripts="$container/$candidate"
            break
        fi
    done
    if [ -n "$container_found" ]; then
        break
    fi
    container=$(dirname "$container")
done

if [ -z "$container_found" ]; then
    echo "pre-commit: container scripts/ not found above $repo_root; refusing to pass an unrunnable gate." >&2
    exit 1
fi

scripts="$container_scripts"

# Locate a Python. If none is found the hook FAILS rather than passing
# silently — an unrunnable check must never look like a passing one.
if command -v py >/dev/null 2>&1; then
    PY="py -3"
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "pre-commit: no Python found; refusing to pass an unrunnable gate." >&2
    exit 1
fi

$PY "$scripts/check_branch_naming.py" --project "$container" || {
    echo "pre-commit: branch naming check FAILED - commit refused." >&2
    echo "pre-commit: branches must be 'main', 'feat-<x>' or 'fix-<x>'." >&2
    exit 1
}

$PY "$scripts/check_names.py" --staged --repo "$repo_root" || {
    echo "pre-commit: portable-name check FAILED - commit refused." >&2
    echo "pre-commit: no OS-reserved or unportable file name may be committed." >&2
    exit 1
}

# Line endings, two rules. (1) A staged file identical to HEAD once CRLF is
# normalised changed NOTHING BUT its endings. (2) A staged file whose DOMINANT
# ending flipped while its content also changed was rewritten on its way past
# too - and that one is worse, because something did change, so it looks
# legitimate while the real diff is buried in a whole-file rewrite. Either way
# the diff stops being reviewable, and this container pins `* -text` precisely
# because copy fidelity is compared BYTE for byte. Inline rather than a
# carried script: it is the generated gate that has to hold, and a container
# overrides the machine-wide guard with its own core.hooksPath.
$PY - "$repo_root" <<'PRECOMMIT_EOL_GUARD' || {
import difflib, subprocess, sys


def g(*a):
    d = subprocess.run(["git", "-C", sys.argv[1]] + list(a),
                       capture_output=True)
    return d.stdout if d.returncode == 0 else None


NOISE_FLOOR = 10        # lines of pure ending-noise a diff may carry


def dominant(data):
    # 'CRLF' | 'LF' | None. None for content with no endings and for a tie:
    # neither can have "flipped".
    crlf = data.count(b"\r\n")
    lone = data.count(b"\n") - crlf
    return None if crlf == lone else ("CRLF" if crlf > lone else "LF")


def real_changes(head, staged):
    # Lines that changed in CONTENT, ignoring how they end.
    a = head.replace(b"\r\n", b"\n").split(b"\n")
    b = staged.replace(b"\r\n", b"\n").split(b"\n")
    same = sum(x.size for x in difflib.SequenceMatcher(
        None, a, b, autojunk=False).get_matching_blocks())
    return max(len(a), len(b)) - same


if g("rev-parse", "--verify", "HEAD") is None:
    sys.exit(0)
bad = []
for raw in (g("diff", "--cached", "--name-only", "--diff-filter=M", "-z")
            or b"").split(b"\0"):
    if not raw:
        continue
    path = raw.decode("utf-8", "surrogateescape")
    staged, head = g("show", ":" + path), g("show", "HEAD:" + path)
    if staged is None or head is None or staged == head:
        continue
    if b"\0" in staged[:8000] or b"\0" in head[:8000]:
        continue                                   # binary: not our business
    was, now = dominant(head), dominant(staged)
    if staged.replace(b"\r\n", b"\n") == head.replace(b"\r\n", b"\n"):
        bad.append((path, was, now, "ONLY the line endings changed"))
    elif was and now and was != now:
        # The case rule 1 waves through, and the worse one: a real edit
        # arriving as a whole-file rewrite with the change buried inside.
        # MEASURED, not assumed: an ordinary Windows edit that flips a small
        # file costs almost no diff and passes, because a gate that fires on
        # ordinary work is a gate people learn to bypass.
        real = real_changes(head, staged)
        noise = max(0, max(head.count(b"\n"), staged.count(b"\n")) - real)
        if noise >= NOISE_FLOOR:
            bad.append((path, was, now,
                        "endings rewritten along with the edit: %d line(s) "
                        "really changed, but the flip makes %d more differ "
                        "for no reason" % (real, noise)))
# Worktree endings that already differ from the index are the usual cause and
# are invisible to `git status` (its stat cache skips the content compare).
drift = []
for line in (g("ls-files", "--eol") or b"").decode("utf-8", "replace").splitlines():
    parts = line.split("	")
    flags = parts[0].split()
    if len(flags) >= 2 and flags[0][2:] != flags[1][2:]:
        drift.append((parts[-1].strip(), flags[0], flags[1]))
for path, was, now, why in bad:
    print("pre-commit:   %s  (%s -> %s) - %s" % (path, was or "?", now or "?", why))
if drift:
    print("pre-commit: worktree endings already differ from the index here")
    print("pre-commit: (`git status` cannot see this; `git ls-files --eol` can):")
    for path, i, w in drift[:10]:
        print("pre-commit:   %s  (%s %s)" % (path, i, w))
    print("pre-commit: restore one with: rm <path> && git checkout -- <path>")
sys.exit(1 if bad else 0)
PRECOMMIT_EOL_GUARD
    echo "pre-commit: line-ending check FAILED - commit refused." >&2
    echo "pre-commit: the file(s) above changed ONLY their line endings," >&2
    echo "pre-commit: which rewrites the whole file and hides the real diff." >&2
    echo "pre-commit: A script reading with read_text() and writing with" >&2
    echo "pre-commit: write_text() does this on Windows - use BINARY mode." >&2
    echo "pre-commit: If the conversion IS the change, use --no-verify." >&2
    exit 1
}

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
case "$branch" in
  main|master)
    # The creation commit is the exception: there is no HEAD yet, and a
    # repository has to start somewhere. A merge is the second one — that
    # is how an accepted branch is meant to arrive. Two more admissions,
    # each narrow on purpose:
    #   * a STORE-ONLY refresh committed immediately after a merge lands
    #     (HEAD is itself a merge commit) — the post-merge hook's own
    #     "chore(memory): refresh the map after the merge" commit, and
    #     `memory/` ONLY: hook and merge-driver files travel by pull
    #     request from here on, never through this exemption;
    #   * a one-time BOOTSTRAP where every staged furniture path is NEW —
    #     those files are untracked in any product whose gate was
    #     installed after its creation commit, and while they stay
    #     untracked the first branch commits them and the merge back into
    #     main aborts on "untracked working tree files would be
    #     overwritten": main could then never receive a pull request at
    #     all. The second time these paths are staged they are
    #     modifications, not additions, and this refuses them.
    if git rev-parse --verify HEAD >/dev/null 2>&1 &&
       [ ! -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
      staged=$(git diff --cached --name-only)
      added=$(git diff --cached --diff-filter=A --name-only)
      staged_sorted=$(printf '%s\n' "$staged" | sort)
      added_sorted=$(printf '%s\n' "$added" | sort)
      admitted=
      if [ -n "$staged" ] && ! printf '%s\n' "$staged" | grep -qvE '^memory(/|$)' \
         && git rev-parse --verify --quiet "HEAD^2" >/dev/null 2>&1; then
        admitted="post-merge store refresh (HEAD is itself a merge commit)"
      elif [ -n "$staged" ] && [ "$staged_sorted" = "$added_sorted" ] \
         && ! printf '%s\n' "$staged" | grep -qvE '^(\.githooks|\.gitattributes|memory)(/|$)'; then
        admitted="bootstrap: every staged furniture path is new, none was tracked before"
      fi
      if [ -n "$admitted" ]; then
        echo "pre-commit: admitted on '$branch' - $admitted:" >&2
        echo "pre-commit: this is the arrangement, not development." >&2
      else
        echo "pre-commit: development on '$branch' is refused: '$branch' takes" >&2
        echo "pre-commit: the repository's creation commit, merges, a" >&2
        echo "pre-commit: post-merge store refresh and a one-time furniture" >&2
        echo "pre-commit: bootstrap, nothing else. Take this path:" >&2
        echo "pre-commit:" >&2
        # ONE route, both natures (repository-policy.md §2.2): a product
        # root is `<...>/main` in a single-product container and in a
        # multi-product one alike, and its branches are its own sibling
        # folders. The second arm is not another topology — it is a
        # repository that is not in the branch-folder layout yet, where a
        # sibling worktree would land among ITS siblings and mean something
        # else entirely.
        if [ "$(basename "$repo_root")" = "main" ]; then
            echo "pre-commit:   1. create the branch and its folder beside main/:" >&2
            echo "pre-commit:      py $container/scripts/container_repo.py start-branch \"$repo_root\" --name feat-<slug>" >&2
            echo "pre-commit:   2. switch to it: continue in the folder it prints." >&2
            echo "pre-commit:" >&2
            echo "pre-commit: This container keeps every branch in its own folder," >&2
            echo "pre-commit: so moving there IS the switch. Add --carry to take" >&2
            echo "pre-commit: work already in main/ with you." >&2
        else
            echo "pre-commit:   1. create the branch and switch to it:" >&2
            echo "pre-commit:      git switch -c feat-<slug>     # or fix-<slug>" >&2
            echo "pre-commit:   2. commit there." >&2
            echo "pre-commit:" >&2
            echo "pre-commit: Uncommitted work follows the switch; nothing is lost." >&2
            echo "pre-commit: NOTE: this repository is not in the branch-folder" >&2
            echo "pre-commit: layout — its product root should be <...>/main" >&2
            echo "pre-commit: (project-structure.md invariant 11a). Until it is," >&2
            echo "pre-commit: branches live in place, as above." >&2
        fi
        echo "pre-commit:" >&2
        echo "pre-commit: Merges, the creation commit, a post-merge store" >&2
        echo "pre-commit: refresh and a one-time furniture bootstrap are" >&2
        echo "pre-commit: allowed; --no-verify bypasses this deliberately and" >&2
        echo "pre-commit: visibly." >&2
        exit 1
      fi
    fi
    ;;
esac


# --- refresh this repository's own memory store, and stage what THIS run
#     made dirty ---------------------------------------------------------
# The map is a TRACKED file that a hook regenerates, so it must travel inside
# the commit that changed the tree it describes. Left dirty in the working
# tree instead, it stops the next merge dead -- "your local changes to
# memory/graph/nodes.jsonl would be overwritten by merge" -- which on a
# product's main is the only way work ever arrives.
#
# BOTH HALVES ARE SCOPED, and each because the unscoped form did damage in a
# delivered system (ported upstream from WebFactory, debt #28, 2026-08-10):
#
#   * WHOLESALE staging. `git add -- "$repo_root/memory"` staged every path
#     in the store, whoever had put it there. A container running concurrent
#     agents therefore committed another agent's in-flight store file under
#     somebody else's message. Pathspec scoping cannot save you: for a
#     pathspec commit git builds a temporary index and this hook's `git add`
#     writes into that same index, so the hook's opinion arrives after the
#     author's.
#   * UNCONDITIONAL rescan. The scan SKIPS the store's own directory by rule
#     (`memory_graph.py walk_tracked`), so a commit whose every staged path is
#     inside the store cannot move the map. Rescanning anyway rewrites rows
#     nobody asked about and sweeps them into one bookkeeping commit.
#
# So: refresh only when this commit contains something the scan can SEE, and
# stage only the paths this run made dirty -- clean before it ran, dirty
# after. A path a concurrent agent had already staged is in neither set; one
# it had edited and not staged is in BOTH, and is left alone for the same
# reason. Either way this hook adds only its own work.
store_dirty() {
    git -C "$repo_root" diff --name-only -- memory 2>/dev/null
    git -C "$repo_root" ls-files --others --exclude-standard -- memory 2>/dev/null
}

# An unborn HEAD -- the repository's creation commit -- has nothing to diff
# against, so there the index itself is the answer; reading it as "no staged
# paths" would skip the very first scan.
if git -C "$repo_root" rev-parse --verify HEAD >/dev/null 2>&1; then
    staged=$(git -C "$repo_root" diff --cached --name-only) || staged=""
else
    staged=$(git -C "$repo_root" ls-files --cached) || staged=""
fi
scan_needed=no
if [ -n "$staged" ] && printf '%s\n' "$staged" | grep -qv '^memory/'; then
    scan_needed=yes
fi

if [ ! -f "$repo_root/memory/store-role.json" ]; then
    if [ -d "$repo_root/memory" ]; then
        echo "$HOOK: $repo_root/memory has no store-role.json, so the store was NOT refreshed" >&2
        echo "$HOOK:   memory_graph.py init --store $repo_root/memory --role container" >&2
    fi
elif [ "$scan_needed" = no ]; then
    :   # nothing staged that the scan looks at; the map cannot have moved
elif [ ! -f "$scripts/memory_graph.py" ]; then
    echo "$HOOK: $scripts/memory_graph.py is missing; the store was not refreshed." >&2
else
    memory_dirty_before=$(store_dirty) || memory_dirty_before=""
    refresh_report=$($PY "$scripts/memory_graph.py" refresh \
        --store "$repo_root/memory" --root "$repo_root" 2>/dev/null) || {
        echo "$HOOK: memory refresh reported a problem. Run it by hand:" >&2
        echo "$HOOK:   memory_graph.py refresh --store $repo_root/memory --root $repo_root" >&2
    }
    # THE VERDICT THE PAYLOAD CARRIES, not the exit code it does not spend.
    # `refresh` returns 0 whenever the store could be READ at all -- a hook
    # must never turn a good commit into a failure -- and reports what
    # happened in its JSON instead. So a PARTIAL refresh (a REFUSED scan, a
    # wrong recorded root, an unreadable scan state) travelled inside a
    # commit in complete silence: the branch above only fires on exit 2, and
    # the map stayed as stale as it was while every gate downstream read it
    # as current. The report is read here, with the stdlib and never `jq`,
    # and one loud line is printed. The commit still proceeds: a stale map is
    # a problem and a refused commit is a worse one
    # (`redistribution.md`, `repository-policy.md`).
    printf '%s' "$refresh_report" | $PY -c 'import json, sys
try:
    payload = json.loads(sys.stdin.read() or "{}")
except ValueError:
    payload = None
if isinstance(payload, dict) and payload.get("verdict") not in (None, "OK"):
    def part(key):
        value = payload.get(key)
        return value if isinstance(value, dict) else {}
    scan, index = part("scan"), part("index")
    reason = (scan.get("error") or index.get("error")
              or scan.get("verdict") or index.get("verdict")
              or payload.get("verdict"))
    remedy = (scan.get("remedy") or index.get("remedy")
              or "memory_graph.py refresh --store %s/memory --root %s"
              % (sys.argv[2], sys.argv[2]))
    sys.stderr.write(
        "%s: memory refresh %s - %s; commit continues; run: %s\n"
        % (sys.argv[1], payload.get("verdict"), reason, remedy))
' "$HOOK" "$repo_root" || true
    store_dirty | while IFS= read -r changed_path; do
        [ -n "$changed_path" ] || continue
        if printf '%s\n' "$memory_dirty_before" | grep -qxF -- "$changed_path"; then
            continue        # somebody else's in-flight edit, not this refresh
        fi
        git -C "$repo_root" add -- "$changed_path" >/dev/null 2>&1 || true
    done
fi
